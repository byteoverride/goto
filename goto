#!/bin/sh
# goto - A lightweight directory shortcut manager for POSIX shells
# https://github.com/byteoverride/goto
# License: MIT

VERSION="1.0.0"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/goto"
CONFIG_FILE="${CONFIG_DIR}/config"

# Exit codes
EXIT_SUCCESS=0
EXIT_ERROR=1
EXIT_USAGE=2

# ANSI colors and symbols (disabled when not writing to a terminal)
if [ -t 1 ]; then
    GREEN="\033[1;32m"
    RED="\033[1;31m"
    YELLOW="\033[1;33m"
    BLUE="\033[1;34m"
    CYAN="\033[1;36m"
    RESET="\033[0m"
    CHECK="✅"
    CROSS="❌"
    BULLET="🔹"
else
    GREEN="" RED="" YELLOW="" BLUE="" CYAN="" RESET="" # shellcheck disable=SC2034
    CHECK="[ok]"
    CROSS="[!!]"
    BULLET="*"
fi

ensure_config_file() {
    [ -d "$CONFIG_DIR" ] || mkdir -p "$CONFIG_DIR"
    [ -f "$CONFIG_FILE" ] || touch "$CONFIG_FILE"
}

validate_name() {
    if [ -z "$1" ]; then
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} Shortcut name cannot be empty.\n" >&2
        return 1
    fi
    case "$1" in
        *[!a-zA-Z0-9_-]*)
            # shellcheck disable=SC2059
            printf "${RED}Error:${RESET} Invalid shortcut name '%s'.\n" "$1" >&2
            # shellcheck disable=SC2059
            printf "Only ${YELLOW}letters, numbers, underscores, and hyphens${RESET} are allowed.\n" >&2
            return 1
            ;;
    esac
}

resolve_path() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null
    elif [ -d "$1" ]; then
        (cd "$1" && pwd)
    elif [ -d "$(dirname "$1")" ]; then
        printf '%s/%s' "$(cd "$(dirname "$1")" && pwd)" "$(basename "$1")"
    else
        printf '%s' "$1"
    fi
}

register_shortcut() {
    name="$1"
    path="$2"
    validate_name "$name" || exit $EXIT_USAGE

    path=$(resolve_path "$path")
    if [ ! -d "$path" ]; then
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} Path '%s' does not exist or is not a directory.\n" "$path" >&2
        exit $EXIT_ERROR
    fi

    ensure_config_file

    grep -v "^${name}|" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" 2>/dev/null
    mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
    printf '%s|%s\n' "$name" "$path" >> "$CONFIG_FILE"
    # shellcheck disable=SC2059
    printf "${GREEN}${CHECK} Registered:${RESET} '%s' -> ${CYAN}%s${RESET}\n" "$name" "$path"
}

delete_shortcut() {
    name="$1"
    validate_name "$name" || exit $EXIT_USAGE
    ensure_config_file

    if grep -q "^${name}|" "$CONFIG_FILE"; then
        grep -v "^${name}|" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
        mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
        # shellcheck disable=SC2059
        printf "${RED}${CROSS} Deleted:${RESET} Shortcut '%s' removed.\n" "$name"
    else
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} Shortcut '%s' not found.\n" "$name" >&2
        exit $EXIT_ERROR
    fi
}

rename_shortcut() {
    old_name="$1"
    new_name="$2"
    validate_name "$old_name" || exit $EXIT_USAGE
    validate_name "$new_name" || exit $EXIT_USAGE
    ensure_config_file

    old_path=$(grep "^${old_name}|" "$CONFIG_FILE" | head -1 | cut -d'|' -f2-)
    if [ -z "$old_path" ]; then
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} Shortcut '%s' not found.\n" "$old_name" >&2
        exit $EXIT_ERROR
    fi

    if grep -q "^${new_name}|" "$CONFIG_FILE"; then
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} Shortcut '%s' already exists. Delete it first.\n" "$new_name" >&2
        exit $EXIT_ERROR
    fi

    grep -v "^${old_name}|" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
    mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
    printf '%s|%s\n' "$new_name" "$old_path" >> "$CONFIG_FILE"
    # shellcheck disable=SC2059
    printf "${GREEN}${CHECK} Renamed:${RESET} '%s' -> '%s'\n" "$old_name" "$new_name"
}

list_shortcuts() {
    ensure_config_file
    if [ ! -s "$CONFIG_FILE" ]; then
        printf "No shortcuts registered. Use 'goto -r <name> [path]' to add one.\n"
        return $EXIT_ERROR
    fi

    printf "Registered shortcuts:\n\n"

    while IFS='|' read -r name path || [ -n "$name" ]; do
        [ -z "$name" ] && continue
        if [ -d "$path" ]; then
            # shellcheck disable=SC2059
            printf "  ${YELLOW}%-15s${RESET} -> ${CYAN}%s${RESET}\n" "$name" "$path"
        else
            # shellcheck disable=SC2059
            printf "  ${YELLOW}%-15s${RESET} -> ${RED}%s${RESET} (missing)\n" "$name" "$path"
        fi
    done < "$CONFIG_FILE"

    printf "\n"
}

resolve_shortcut() {
    input="$1"

    # Split on first slash for subpath support
    name="${input%%/*}"
    if [ "$input" = "$name" ]; then
        subpath=""
    else
        subpath="${input#*/}"
    fi

    validate_name "$name" || return $EXIT_USAGE
    ensure_config_file

    base=$(grep "^${name}|" "$CONFIG_FILE" | head -1 | cut -d'|' -f2-)

    if [ -z "$base" ]; then
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} Shortcut '%s' not found.\n" "$name" >&2
        return $EXIT_ERROR
    fi

    if [ -n "$subpath" ]; then
        target="${base}/${subpath}"
    else
        target="$base"
    fi

    if [ -d "$target" ]; then
        printf '%s\n' "$target"
    else
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} Path '%s' does not exist.\n" "$target" >&2
        return $EXIT_ERROR
    fi
}

cleanup_shortcuts() {
    ensure_config_file
    if [ ! -s "$CONFIG_FILE" ]; then
        printf "No shortcuts registered. Nothing to clean up.\n"
        return $EXIT_SUCCESS
    fi

    removed=0
    tmpfile="${CONFIG_FILE}.tmp"
    : > "$tmpfile"

    while IFS='|' read -r name path || [ -n "$name" ]; do
        [ -z "$name" ] && continue
        if [ -d "$path" ]; then
            printf '%s|%s\n' "$name" "$path" >> "$tmpfile"
        else
            # shellcheck disable=SC2059
            printf "${RED}${CROSS} Removed:${RESET} '%s' -> %s (missing)\n" "$name" "$path"
            removed=$((removed + 1))
        fi
    done < "$CONFIG_FILE"

    mv "$tmpfile" "$CONFIG_FILE"

    if [ "$removed" -eq 0 ]; then
        printf "All shortcuts are valid. Nothing to clean up.\n"
    else
        printf "\nRemoved %d broken shortcut(s).\n" "$removed"
    fi
}

export_shortcuts() {
    ensure_config_file
    if [ ! -s "$CONFIG_FILE" ]; then
        printf "No shortcuts to export.\n" >&2
        return $EXIT_ERROR
    fi
    cat "$CONFIG_FILE"
}

import_shortcuts() {
    file="$1"
    if [ ! -f "$file" ]; then
        # shellcheck disable=SC2059
        printf "${RED}Error:${RESET} File '%s' not found.\n" "$file" >&2
        return $EXIT_ERROR
    fi

    ensure_config_file
    count=0
    skipped=0

    while IFS='|' read -r name path || [ -n "$name" ]; do
        [ -z "$name" ] && continue

        # Validate name format
        case "$name" in
            *[!a-zA-Z0-9_-]*) skipped=$((skipped + 1)); continue ;;
        esac

        # Remove existing entry with same name, then add
        grep -v "^${name}|" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" 2>/dev/null
        mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
        printf '%s|%s\n' "$name" "$path" >> "$CONFIG_FILE"
        count=$((count + 1))
    done < "$file"

    # shellcheck disable=SC2059
    printf "${GREEN}${CHECK} Imported:${RESET} %d shortcut(s)" "$count"
    if [ "$skipped" -gt 0 ]; then
        printf " (%d skipped due to invalid names)" "$skipped"
    fi
    printf "\n"
}

print_help() {
    # shellcheck disable=SC2059
    printf "${CYAN}goto${RESET} v%s - Directory shortcut manager\n\n" "$VERSION"
    printf "Usage:\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto <name>${RESET}              Jump to a shortcut\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto <name>/<subpath>${RESET}    Jump to a subdirectory of a shortcut\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto -r <name> [path]${RESET}   Register shortcut (default: current dir)\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto -d <name>${RESET}           Delete a shortcut (alias: -u)\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto -R <old> <new>${RESET}     Rename a shortcut\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto -l${RESET}                  List all shortcuts\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto -c${RESET}                  Clean up broken shortcuts\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto --export${RESET}            Export shortcuts to stdout\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto --import <file>${RESET}     Import shortcuts from file\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto -h${RESET}                  Show this help message\n"
    # shellcheck disable=SC2059
    printf "  ${BULLET} ${YELLOW}goto -V${RESET}                  Show version\n"
}

# ==== Main Entry Point ====

case "$1" in
    -h|--help)
        print_help
        ;;
    -V|--version)
        printf "goto %s\n" "$VERSION"
        ;;
    -r)
        if [ $# -lt 2 ]; then
            # shellcheck disable=SC2059
            printf "${RED}Usage:${RESET} goto -r <name> [path]\n" >&2
            exit $EXIT_USAGE
        fi
        register_shortcut "$2" "${3:-.}"
        ;;
    -d|-u)
        if [ $# -ne 2 ]; then
            # shellcheck disable=SC2059
            printf "${RED}Usage:${RESET} goto -d <name>\n" >&2
            exit $EXIT_USAGE
        fi
        delete_shortcut "$2"
        ;;
    -R)
        if [ $# -ne 3 ]; then
            # shellcheck disable=SC2059
            printf "${RED}Usage:${RESET} goto -R <old-name> <new-name>\n" >&2
            exit $EXIT_USAGE
        fi
        rename_shortcut "$2" "$3"
        ;;
    -l|--list)
        list_shortcuts
        ;;
    -c|--cleanup)
        cleanup_shortcuts
        ;;
    --export)
        export_shortcuts
        ;;
    --import)
        if [ $# -ne 2 ]; then
            # shellcheck disable=SC2059
            printf "${RED}Usage:${RESET} goto --import <file>\n" >&2
            exit $EXIT_USAGE
        fi
        import_shortcuts "$2"
        ;;
    -*)
        printf "Unknown option: %s\n" "$1" >&2
        print_help >&2
        exit $EXIT_USAGE
        ;;
    "")
        # shellcheck disable=SC2059
        printf "${RED}Missing shortcut name.${RESET} Use -l to list or -h for help.\n" >&2
        exit $EXIT_USAGE
        ;;
    *)
        resolve_shortcut "$1"
        ;;
esac
